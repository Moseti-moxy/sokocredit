# Change the username/password to the PostgreSQL role created for this project.
DATABASE_URL=postgresql+psycopg2://sokocredit_user:change-this-password@localhost:5432/sokocredit
JWT_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=true

# Get these from your Daraja sandbox app. Never commit real credentials.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace-with-daraja-passkey
# Use the current public HTTPS URL printed by ngrok, followed by this exact path.
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/mpesa/stk-callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Key for encrypting sensitive fields at rest (e.g. customer PII columns using
# app.security.EncryptedString). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before running `flask db upgrade` for the encryption migration, and
# must stay the same afterwards - rotating it without a re-encryption pass
# makes existing customer PII undecryptable (see app/security.py's docstring
# on key rotation via MultiFernet if you ever need to rotate this key).
FIELD_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# File uploads (customer ID/permit documents). Defaults to instance/uploads if unset.
UPLOAD_FOLDER=./instance/uploads

# Airtel Money (Open API - https://developers.airtel.africa, Collections product)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=replace-with-airtel-client-id
AIRTEL_CLIENT_SECRET=replace-with-airtel-client-secret
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES
# Shared secret configured in your Airtel developer dashboard, used to verify
# that a POST to /api/airtel/callback actually came from Airtel.
AIRTEL_CALLBACK_SECRET=replace-with-airtel-callback-secret

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret

# SMS via Africa's Talking (https://africastalking.com) - used for payment reminders
AFRICASTALKING_ENV=sandbox
AFRICASTALKING_USERNAME=replace-with-at-username
AFRICASTALKING_API_KEY=replace-with-at-api-key
AFRICASTALKING_SENDER_ID=

# WhatsApp via Meta's WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp)
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
WHATSAPP_API_VERSION=v20.0

# Credit Reference Bureau (Metropol / TransUnion Kenya / Creditinfo). These are
# NOT self-serve - you must sign a data-sharing agreement with a licensed CRB
# before you have anything to put here. See app/crb.py.
CRB_PROVIDER=
CRB_API_BASE_URL=
CRB_API_KEY=

# Business registration lookups (Kenya eCitizen/BRS). Also requires a signed
# API consumer agreement, not just an API key. See app/business_registry.py.
BRS_API_BASE_URL=
BRS_API_KEY=

