# Copy to .env and adjust as needed.

# Base URL for the Flask API. Defaults to /api (works with a Vite dev proxy).
VITE_API_BASE_URL=/api

# Set to "false" to use the real Flask auth endpoints (/api/auth/login for
# staff, /api/customer-auth/login and /api/customer-auth/register for
# customers). While true, Login/Signup use the demo accounts in src/data/mockAuth.js:
#   Agent ID: AGT-8492  Password: password123
#   Agent ID: ADM-1001  Password: admin123  (admin role — unlocks Settings/Audit Log)
VITE_USE_MOCK_AUTH=true

# Stripe's publishable key (safe to expose client-side - it can only create
# payment intents, never charge without the matching secret key server-side).
# Used by the customer portal's card-payment option. Get it from
# https://dashboard.stripe.com/apikeys (use a test-mode key, pk_test_...,
# until STRIPE_SECRET_KEY on the backend is also switched to live mode).
VITE_STRIPE_PUBLISHABLE_KEY=
